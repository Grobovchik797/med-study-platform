            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "text": "Пульпа",
            "kind": "rowheader",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Эктомезенхима зубного сосочка.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Фибробласты, одонтобласты, иммунные клетки, сосуды и нервы.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Рыхлая соединительная ткань с коллагеном и основным веществом.",
