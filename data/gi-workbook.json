          }
        ],
        [
          {
            "text": "Околоушная",
            "kind": "rowheader",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Эпителиальный зачаток полости рта (обычно относят к эктодерме).",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Сложная разветвлённая серозная железа.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Серозные ацинусы и миоэпителиальные клетки.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Развиты вставочные, исчерченные и междольковые протоки.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Водянистая слюна, ферменты, защитные белки.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "text": "Подчелюстная",
            "kind": "rowheader",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Эпителиальный зачаток дна первичной полости рта.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Сложная смешанная, преобладает серозный компонент.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Серозные и смешанные концевые отделы; миоэпителиальные клетки.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Вставочные короче, исчерченные хорошо выражены.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Смешанный секрет: увлажнение, ферменты и защита.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "text": "Подъязычная",
            "kind": "rowheader",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Эпителиальный зачаток дна первичной полости рта.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Сложная смешанная, преобладает слизистый компонент.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Преимущественно слизистые и смешанные отделы.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Слабо выраженные вставочные и исчерченные, несколько выводных протоков.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          },
          {
            "text": "Слизистый секрет: смазывание и защита.",
            "kind": "answer",
            "colspan": 1,
            "rowspan": 1
          }
        ]
